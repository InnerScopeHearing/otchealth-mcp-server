[
  {
    "command": [
      "echo '' | base64 -d > /tmp/run.sh && sh /tmp/run.sh"
    ],
    "cpu": 0,
    "entryPoint": [
      "/bin/sh",
      "-c"
    ],
    "environment": [
      {
        "name": "SCHEMA_B64",
        "value": ""
      }
    ],
    "essential": true,
    "image": "postgres:16",
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/otchealth",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "agentstate-schema"
      }
    },
    "mountPoints": [],
    "name": "schema",
    "portMappings": [],
    "secrets": [
      {
        "name": "PGHOST",
        "valueFrom": "arn:aws:ssm:us-east-1:900915535335:parameter/otchealth/aws-pg-host"
      },
      {
        "name": "PGUSER",
        "valueFrom": "arn:aws:ssm:us-east-1:900915535335:parameter/otchealth/aws-pg-master-user"
      },
      {
        "name": "PGPASSWORD_IN",
        "valueFrom": "arn:aws:ssm:us-east-1:900915535335:parameter/otchealth/aws-pg-master-password"
      }
    ],
    "systemControls": [],
    "volumesFrom": []
  }
]
