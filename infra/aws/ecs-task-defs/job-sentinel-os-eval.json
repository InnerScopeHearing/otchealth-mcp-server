[
  {
    "command": [
      "mkdir -p /app /tmp/upgrades/sentinel && cd /app && npm init -y >/dev/null 2>&1 && echo \"$RUNMULTI_B64\" | base64 -d > /app/run-multi.mjs && echo \"$RUNNER_B64\" | base64 -d > /app/eval-runner-app.v3-http.mjs && echo \"$BATTERY_B64\" | base64 -d > /app/battery_v2.json && echo \"$JUDGE_B64\" | base64 -d > /app/judge_v1.json && echo \"$CANARY_B64\" | base64 -d > /app/canary.json && echo \"$RAGAS_B64\" | base64 -d > /app/ragas-metrics.mjs && echo \"$MULTISAMPLE_B64\" | base64 -d > /app/multisample.mjs && echo \"$AUTH_B64\" | base64 -d > /app/auth.mjs && echo \"$HTTPCLIENT_B64\" | base64 -d > /app/http_client.mjs && echo \"$OS_ACCESS_CODE\" > /tmp/upgrades/sentinel/.os_access_code && node run-multi.mjs 3"
