[
  {
    "command": [
      "apt-get update -qq && apt-get install -y -qq git >/dev/null 2>&1; git clone --depth 1 https://github.com/innerscopehearing/otchealth-claude-tools /app && cd /app && node skills/fleet-secret-custodian/custodian.mjs audit"
    ],
    "cpu": 0,
    "entryPoint": [
      "/bin/sh",
      "-c"
    ],
    "environment": [
      {
        "name": "GATEWAY_BASE_URL",
        "value": "https://mcp.otchealth.app"
      },
      {
        "name": "ROTATE_AGE_DAYS_APIKEY",
        "value": "90"
      },
      {
        "name": "AZURE_KEYVAULT_NAME",
        "value": "kv-otc-55c84f6bef"
      },
      {
        "name": "AZURE_SUBSCRIPTION_ID",
        "value": "55c84f6b-ef90-4259-a58b-50835cc4cab4"
      },
      {
        "name": "CUSTODIAN_TRIGGER",
        "value": "scheduled-audit"
      },
      {
        "name": "CUSTODIAN_CONTAINER",
        "value": "secret-custodian-audit"
      },
      {
        "name": "CUSTODIAN_STORAGE_ACCOUNT",
        "value": "stotc55c84f6bef"
      },
      {
        "name": "CUSTODIAN_GRACE_HOURS",
        "value": "24"
      }
    ],
    "essential": true,
    "image": "node:20-bookworm-slim",
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/otchealth",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "fleet-secret-custodian"
      }
    },
    "mountPoints": [],
    "name": "job",
    "portMappings": [],
    "secrets": [],
    "systemControls": [],
    "volumesFrom": []
  }
]
