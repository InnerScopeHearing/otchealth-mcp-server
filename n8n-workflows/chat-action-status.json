{
  "name": "OTCHealth Chat Action Status",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "webhook",
      "name": "Chat Action Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "chat-action-status",
      "parameters": {
        "httpMethod": "POST",
        "path": "chat-action-status",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "verify",
      "name": "Verify HMAC",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto'); const secret = $env.N8N_WEBHOOK_SECRET; if (!secret) throw new Error('N8N_WEBHOOK_SECRET missing'); const h = $json.headers || {}; const raw = $binary?.data?.data ? Buffer.from($binary.data.data, 'base64').toString('utf8') : JSON.stringify($json.body || {}); const expected = crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex'); const body = $json.body || JSON.parse(raw); const callerHash = h['x-caller-hash'] || h['X-Caller-Hash']; return [{ json: { authorized: Boolean((h['x-signature-sha256'] || h['X-Signature-Sha256']) === expected && typeof body.job_id === 'string' && body.job_id.length > 0 && typeof callerHash === 'string'), caller_hash: callerHash, body } }];"
      }
    },
    {
      "id": "get",
      "name": "Read Opaque Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        940,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_GATEWAY_BASE_URL + '/internal/chat-actions/jobs/status' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { job_id: $('Verify HMAC').first().json.body.job_id, caller_hash: $('Verify HMAC').first().json.caller_hash } }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "OTCHealth Gateway Service"
        }
      }
    },
    {
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1180,
        220
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, result: $json }) }}"
      }
    },
    {
      "id": "reject",
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        940,
        430
      ],
      "parameters": {
        "respondWith": "json",
        "responseCode": 401,
        "responseBody": "={{ JSON.stringify({ success: false, error: 'invalid_signature_or_job_id' }) }}"
      }
    },
    {
      "id": "authorization-gate",
      "name": "Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    }
  ],
  "connections": {
    "Chat Action Status": {
      "main": [
        [
          {
            "node": "Verify HMAC",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Opaque Job Status": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify HMAC": {
      "main": [
        [
          {
            "node": "Authorized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authorized?": {
      "main": [
        [
          {
            "node": "Read Opaque Job Status",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Reject",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "_otchealth_mcp_metadata": {
    "required_gateway_credential": "OTCHealth Gateway Service",
    "required_env": [
      "N8N_WEBHOOK_SECRET",
      "N8N_GATEWAY_BASE_URL"
    ],
    "import_instructions": "Import inactive, bind OTCHealth Gateway Service on Read Opaque Job Status, set the two n8n environment variables, test with a synthetic opaque job id, then activate."
  }
}
