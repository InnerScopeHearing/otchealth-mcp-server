# OTCHealth MCP Server - Environment Variables Template
#
# Real values are in .env (gitignored, never pushed).
# Populate from the Notion API Tokens & Credentials vault.

# ===== Customer.io credentials (workspace 193366, US region) =====
CIO_SITE_ID=
CIO_TRACK_KEY=
CIO_APP_API_BEARER=

# ===== MCP server auth =====
PERPLEXITY_CONNECTOR_TOKEN=
ADMIN_REVOKE_TOKEN=

# ===== OAuth 2.1 (confidential client; enables Hyperagent/standard MCP OAuth connect) =====
# When OAUTH_CLIENT_ID + OAUTH_TOKEN_SIGNING_SECRET are set, the gateway issues real expiring JWT
# access/refresh tokens (PKCE S256 mandatory, client_secret required at token endpoint). Leave all
# blank to keep the legacy static-connector-token behavior.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# Also feeds a dedicated HKDF context for the AES-256-GCM HeyGen OAuth token broker. Required for
# POST /heygen/pair and every heygen_* data tool; no separate HeyGen encryption secret is used.
OAUTH_TOKEN_SIGNING_SECRET=
# Comma-separated allow-list of exact redirect URIs (e.g. the Hyperagent connector redirect URI).
OAUTH_REDIRECT_URIS=
# Optional: force the public base URL used in OAuth metadata (recommended behind a proxy/CDN).
PUBLIC_BASE_URL=https://mcp.otchealth.app
# Lane bound to the static PERPLEXITY_CONNECTOR_TOKEN and to the single confidential OAUTH_CLIENT_ID
# connection. Production uses 'cto' (NOT an EXEC_RING lane, so it is safe). SECURITY: NEVER set this to
# an EXEC_RING lane (cfo/clo/clo-personal/coo/cro/cpo/cco/exec) -- those are broadly-held, long-lived
# static credentials, so a privileged lane here would hand MNPI/attorney-privileged access to every
# static-token caller. The gateway logs a loud startup warning (type=oauth_default_agent_privileged)
# if it is ever set to an EXEC_RING lane.
OAUTH_DEFAULT_AGENT=cto
# DEPRECATED / NO-OP as of the Phase 6 connector-ring closure (2026-07-15). Public self-registered DCR
# (Claude connector) clients are now HARD-BOUND to the non-privileged 'external-read' lane regardless
# of connector name, so there is no longer any name->lane inference for this to override. A privileged
# lane requires a CONFIDENTIAL client (OAUTH_CLIENTS / OAUTH_CLIENT_ID with a secret). Left here only so
# an existing deployment that sets it does not error; it is ignored.
OAUTH_DCR_DEFAULT_AGENT=
# ===== Connector toolset overrides (optional; blank = built-in defaults in tools/registry.ts) =====
# CONNECTOR_TOOLSET (csv) overrides the toolset advertised to SHIP-lane connectors (cto/developer/
# EXEC_RING). EXTERNAL_READONLY_TOOLSET (csv) overrides the toolset advertised to every other
# connector lane -- SECURITY-CRITICAL: keep this a minimal, non-privileged read set; it is what an
# unauthorized/unrecognized external connector sees.
CONNECTOR_TOOLSET=
EXTERNAL_READONLY_TOOLSET=

# ===== n8n integration =====
N8N_BASE_URL=https://automation.otchealth.app
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ===== Cloudflare =====
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ===== Microsoft Graph (COO send-as coo@otchealthmart.com) =====
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=coo@otchealthmart.com

# ===== Stripe (read-only) =====
STRIPE_SECRET_KEY=

# ===== kb-memory shared brain (commons store ONLY; the cross-agent / cross-platform memory) =====
# Mirrors skills/kb-memory commons: account otchealthcommons, container company-journal.
# memory_recall + memory_team are read (always live); memory_remember is write_simple (needs
# ENABLE_WRITE_TOOLS=true). RING SAFETY: only the commons (shared, non-sensitive) store is wired
# here. NEVER put the cfo (MNPI), clo / clo-personal (privileged), or any PHI storage account here.
AZURE_COMMONS_STORAGE_ACCOUNT=
AZURE_COMMONS_STORAGE_KEY=

# ===== Agent State Plane (Cosmos DB for NoSQL): work-ledger + structured memory-of-record =====
# Inert without COSMOS_ENDPOINT. COSMOS_AUTH_MODE selects how src/agentstate/cosmos.ts authenticates:
#   key (default) - master-key HMAC auth via COSMOS_KEY (today's behavior, unchanged).
#   aad           - Azure AD bearer auth via the gateway Container App's managed identity (granted
#                   "Cosmos DB Built-in Data Contributor" on the account); COSMOS_KEY is not required
#                   in this mode. Phase 6 migration off the Cosmos master key.
# Leave COSMOS_AUTH_MODE unset (or 'key') to change nothing.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DB=agent-state
COSMOS_AUTH_MODE=key

# ===== Feature flags (defaults match ADR-001 Section 7) =====
READ_ONLY_MODE=true
ENABLE_WRITE_TOOLS=false
ENABLE_HIGH_RISK_TOOLS=false
DRY_RUN_DEFAULT=true

# ===== Server config =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
