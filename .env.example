# OTCHealth MCP Server - Environment Variables Template
#
# Real values are in .env (gitignored, never pushed).
# Populate from the Notion API Tokens & Credentials vault.

# ===== Customer.io credentials (workspace 193366, US region) =====
CIO_SITE_ID=
CIO_TRACK_KEY=
CIO_APP_API_BEARER=

# ===== MCP server auth =====
PERPLEXITY_CONNECTOR_TOKEN=
ADMIN_REVOKE_TOKEN=
# Optional: dedicated secret entered at the OAuth consent screen when approving a
# connector (claude.ai / Hyperagent). If blank, falls back to ADMIN_REVOKE_TOKEN.
OAUTH_CONSENT_SECRET=

# ===== n8n integration =====
N8N_BASE_URL=https://automation.otchealth.app
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ===== Phase 2: Shopify (hearingassist.myshopify.com / otchealthmart.com) =====
SHOPIFY_SHOP=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ACCESS_TOKEN=

# ===== Phase 2: Intercom =====
INTERCOM_ACCESS_TOKEN=

# ===== Phase 2: Depot (FULL API) =====
# Depot org/user API token (Bearer). Source: Depot dashboard -> Settings -> API tokens.
# Values live in Matt's Notion Token Vault under the Depot section.
# Server boots without it; Depot tools return a clear "not configured" error until set.
DEPOT_TOKEN=
# Optional default project id used when a Depot tool does not receive an explicit project_id.
DEPOT_PROJECT_ID=
DEPOT_BASE_URL=https://api.depot.dev

# ===== Phase 2: PostHog management API =====
# Personal API key (starts with phx_), used as a Bearer token. Metadata only.
# The PHI-hardened MedReview project (468398) is never exposed via replay/recording/person tools.
# Source: PostHog -> Settings -> Personal API keys. Value in Matt's Notion Token Vault.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# ===== Cloudflare =====
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ===== Microsoft Graph (COO send-as coo@otchealthmart.com) =====
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=coo@otchealthmart.com

# ===== Stripe (read-only) =====
STRIPE_SECRET_KEY=

# ===== Feature flags (defaults match ADR-001 Section 7) =====
READ_ONLY_MODE=true
ENABLE_WRITE_TOOLS=false
ENABLE_HIGH_RISK_TOOLS=false
DRY_RUN_DEFAULT=true

# ===== Server config =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
