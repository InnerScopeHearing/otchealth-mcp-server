# OTCHealth MCP Server - Environment Variables Template
#
# Real values are in .env (gitignored, never pushed).
# Populate from the Notion API Tokens & Credentials vault.

# ===== Customer.io credentials (workspace 193366, US region) =====
CIO_SITE_ID=
CIO_TRACK_KEY=
CIO_APP_API_BEARER=

# ===== MCP server auth =====
PERPLEXITY_CONNECTOR_TOKEN=
ADMIN_REVOKE_TOKEN=

# ===== n8n integration =====
N8N_BASE_URL=https://automation.otchealth.app
N8N_API_KEY=
N8N_WEBHOOK_SECRET=

# ===== Cloudflare =====
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ===== Microsoft Graph (COO send-as coo@otchealthmart.com) =====
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=coo@otchealthmart.com

# ===== Stripe (read-only) =====
STRIPE_SECRET_KEY=

# ===== kb-memory shared brain (commons store ONLY; the cross-agent / cross-platform memory) =====
# Mirrors skills/kb-memory commons: account otchealthcommons, container company-journal.
# memory_recall + memory_team are read (always live); memory_remember is write_simple (needs
# ENABLE_WRITE_TOOLS=true). RING SAFETY: only the commons (shared, non-sensitive) store is wired
# here. NEVER put the cfo (MNPI), clo / clo-personal (privileged), or any PHI storage account here.
AZURE_COMMONS_STORAGE_ACCOUNT=
AZURE_COMMONS_STORAGE_KEY=

# ===== Feature flags (defaults match ADR-001 Section 7) =====
READ_ONLY_MODE=true
ENABLE_WRITE_TOOLS=false
ENABLE_HIGH_RISK_TOOLS=false
DRY_RUN_DEFAULT=true

# ===== Server config =====
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
