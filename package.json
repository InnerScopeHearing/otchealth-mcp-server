{
  "name": "otchealth-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for OTCHealth's stack. Customer.io first-class integration. Built per ADR-001 (Option C Hybrid: Node + n8n).",
  "type": "module",
  "main": "dist/server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "start:approval-broker": "node dist/server/approval-broker-index.js",
    "dev": "tsx watch src/server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'",
    "evals": "tsx scripts/run-evals.ts"
  },
  "dependencies": {
    "@descope/node-sdk": "^2.14.0",
    "@fastify/rate-limit": "10.3.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dd-trace": "^5.109.0",
    "fastify": "^5.1.0",
    "pg": "8.22.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "undici": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "8.15.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
